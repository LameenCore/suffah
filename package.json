{
  "name": "suffah",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "gen:lessons": "tsx --env-file=.env.local scripts/generate-lessons.ts",
    "gen:checkpoints": "tsx --env-file=.env.local scripts/generate-checkpoints.ts",
    "gen:assessments": "tsx --env-file=.env.local scripts/generate-assessments.ts",
    "gen:exams": "tsx --env-file=.env.local scripts/generate-term-exams.ts",
    "seed:continuity": "tsx --env-file=.env.local scripts/seed-continuity.ts",
    "seed:progress": "tsx --env-file=.env.local scripts/seed-demo-progress.ts",
    "demo:setup": "tsx scripts/demo-setup.ts",
    "demo:reset": "tsx scripts/demo-setup.ts --reset-only",
    "check:integrity": "tsx --env-file=.env.local scripts/check-integrity.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed:auth": "tsx --env-file=.env.local scripts/seed-auth.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
