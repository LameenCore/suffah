# Copy to .env.local and fill in. Nothing here is required for `next build`.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres connection string (Project Settings → Database → Connection string,
# URI form, includes the password). Only used by `npm run migrate` / `npm run seed`.
SUPABASE_DB_URL=

# Anthropic (console.anthropic.com) — needed from Phase 2 onward
ANTHROPIC_API_KEY=

# Demo shortcut: force a dashboard role without the picker (admin | parent | student)
NEXT_PUBLIC_SUFFA_DEV_ROLE=

# Demo mode: set to 1 to show the admin "Reset walkthrough" button and enable
# POST /api/demo/reset. Leave empty in any real deployment.
NEXT_PUBLIC_SUFFA_DEMO_MODE=
